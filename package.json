{
  "name": "aiga-mcp",
  "version": "1.0.0",
  "description": "AIGA: AI Village & Spatial Planning Engine - Autonomous MCP Tool Provider & 3D Web Dashboard for JamotLite",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"import('node:fs').then(fs => fs.cpSync('src/web/public', 'dist/web/public', { recursive: true }));\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test dist/**/*.test.js || tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jamotlite",
    "cesium",
    "gis",
    "spatial-planning",
    "geojson",
    "kml",
    "kmz",
    "turf"
  ],
  "author": "electrichains",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@tmcw/togeojson": "^7.1.3",
    "@turf/turf": "^7.2.0",
    "@xmldom/xmldom": "^0.9.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
